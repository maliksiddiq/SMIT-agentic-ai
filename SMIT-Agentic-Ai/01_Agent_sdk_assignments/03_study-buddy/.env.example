# Study Buddy environment configuration
# Copy this file to .env and fill in your keys.
# Get a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: an OpenAI key enables trace export to https://platform.openai.com/traces
# Leave blank to keep traces recorded locally only.
OPENAI_API_KEY=
